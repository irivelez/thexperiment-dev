---
/**
 * SlotBooker — the only commercial action on the site.
 * Single CTA: Cal.com 40-min conversation. No deposit, no payment.
 * Discovery, not sales.
 */
import { SITE } from '@lib/constants';

interface Props {
  variant?: 'hero' | 'tail';
}

const { variant = 'hero' } = Astro.props;
const isHero = variant === 'hero';
---

<section class:list={['container-page', isHero ? 'pb-12 md:pb-20' : 'section']}>
  {!isHero && <h2 class="mb-8">Book a slot</h2>}

  <a
    href={SITE.cta.booking}
    target="_blank"
    rel="noopener"
    class="group block max-w-3xl border border-ink hover:bg-ink hover:text-paper transition-colors no-underline"
  >
    <div class="p-8 md:p-12 flex flex-col gap-5">
      <span class="eyebrow group-hover:text-paper-line">
        Book a 40-minute conversation
      </span>
      <span class="font-serif text-3xl md:text-5xl leading-[1.05] tracking-tight">
        Pick a time on Cal.com.
      </span>
      <span class="text-base md:text-lg text-ink-subtle group-hover:text-paper-subtle leading-relaxed max-w-2xl">
        English or Spanish. Free. Calendar invite + automated reminders.
        Anonymized in everything I publish — your name and business never appear.
        Quotes only with explicit permission, after the call.
      </span>
      <span class="font-mono text-sm uppercase tracking-[0.18em] mt-4 group-hover:text-signal flex items-center gap-2">
        Open Cal.com <span class="transition-transform group-hover:translate-x-1">→</span>
      </span>
    </div>
  </a>
</section>
