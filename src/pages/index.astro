---
import Base from '@layouts/Base.astro';
import Counter from '@components/Counter.astro';
import PatternsEmerging from '@components/PatternsEmerging.astro';
import DiaryFeed from '@components/DiaryFeed.astro';
import QuoteCarousel from '@components/QuoteCarousel.astro';
import SlotBooker from '@components/SlotBooker.astro';
import CalInline from '@components/CalInline.astro';
import { SITE, HERO, SPINE, VILLAIN } from '@lib/constants';

const renderBold = (text: string) =>
  text.replace(/\*\*(.+?)\*\*/g, '<strong class="font-medium text-ink">$1</strong>');
---

<Base
  title="Day 1 of 12. The bet."
  description={SITE.description}
>
  <Counter />

  <section class="container-page pb-12 md:pb-16">
    <p class="eyebrow mb-6">{HERO.en.eyebrow}</p>
    <h1 class="max-w-4xl text-4xl md:text-6xl leading-[1.1]">
      {HERO.en.question}
    </h1>
  </section>

  <SlotBooker variant="hero" />

  <p class="container-page text-2xs font-mono text-ink-muted -mt-8 md:-mt-16 pb-12 md:pb-16 max-w-3xl">
    No deposit. No sales pitch. The conversation is the experiment.
  </p>

  <section class="section">
    <div class="container-page">
      <p class="eyebrow mb-8">The bet</p>
      <div class="prose-body space-y-5 max-w-reading">
        {SPINE.en.map((paragraph) => (
          <p set:html={renderBold(paragraph)} />
        ))}
      </div>

      <div class="mt-12 max-w-reading border-l-2 border-signal pl-5 py-2">
        <p class="eyebrow text-signal mb-2">Counter-positioning</p>
        <p class="text-base md:text-lg text-ink-subtle leading-relaxed">
          {VILLAIN.en}
        </p>
      </div>

      <p class="mt-10">
        <a href="/method" class="font-mono text-sm tracking-wide hover:text-signal">
          Read the methodology →
        </a>
      </p>
    </div>
  </section>

  <PatternsEmerging />

  <DiaryFeed limit={5} />

  <QuoteCarousel />

  <CalInline />

  <section class="section">
    <div class="container-page max-w-reading">
      <p class="eyebrow mb-4">Or just watch</p>
      <h2>Subscribe to {SITE.newsletter.name}.</h2>
      <p class="mt-4 prose-body">
        {SITE.newsletter.description} Three editions during the sprint
        (May 5, May 10, May 15). Long-form.
      </p>
      <a
        href={SITE.newsletter.url}
        target="_blank"
        rel="noopener"
        class="btn-primary mt-8"
      >
        Subscribe →
      </a>
    </div>
  </section>
</Base>
