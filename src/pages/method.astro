---
import Base from '@layouts/Base.astro';
import { SITE } from '@lib/constants';

const sections = [
  {
    title: 'The conversation',
    body: `Each call is 25 minutes, structured in 5 sections (open, background, pain, future, close). Conducted over Google Meet for English-speakers, WhatsApp video for LATAM SMB founders who prefer it. Recorded with verbal consent. Transcribed with tl;dv or Fathom.`,
    detail: [
      'Open (2 min): set context, get explicit recording permission, frame as "no sale today."',
      'Background (5 min): team size, message volume, current stack.',
      'Pain (10 min): past behavior questions, never future intent. Mom Test discipline.',
      'Future (5 min): magic-wand framing, willingness-to-pay anchored on a single task.',
      'Close (3 min): clarify, ask for referrals, optional pilot mention.',
    ],
  },
  {
    title: 'The principles',
    body: `Borrowed from Rob Fitzpatrick's Mom Test, Steve Blank's customer development, and Eric Migicovsky's YC user-interview canon. Updated for AI-era B2B.`,
    detail: [
      'Past behavior beats future intent. Always ask "tell me about the last time."',
      'Specifics or it didn\'t happen. "Walk me through your last Monday hour by hour."',
      'AI-prep, human-validate. Use Claude/Apollo to source and brief. Never on the call.',
      'WhatsApp is the channel and the medium. Book the call inside WhatsApp when possible.',
      'Confianza beats funnel. Warm intro converts ~5–10× a cold blast.',
    ],
  },
  {
    title: 'The capture stack',
    body: `Markdown files in a private directory. One file per call. Frontmatter holds the structured fields; body holds the prose summary. Files never push to the public repo. The privacy firewall is non-negotiable.`,
    detail: [
      'Filename: YYYY-MM-DD_vertical_NN.md',
      'Frontmatter: vertical, country/city, employees, WhatsApp volume/day, top pain, current workaround, WTP USD, lost-customers/month, magic-wand task, would-pilot, permission status.',
      'Body: 200–400 word summary, key insights, surprises, anonymized quote.',
      'Aggregates: content/patterns.json (manually curated), content/quotes.json (permission-cleared), content/changed-mind.md (contradictions log).',
    ],
  },
  {
    title: 'The synthesis',
    body: `Two passes. Pass one within each call (what did this person uniquely teach me). Pass two across all calls (what do they consistently say that contradicts the consensus). The second pass is where non-obvious lives.`,
    detail: [
      'Daily, within 1h of each call: 5-bullet markdown dump + one-line takeaway.',
      'Every 2 days, promote patterns from "early signal" to "confirmed" if mentioned 3+ times across 2+ verticals.',
      'Day 6: mid-sprint review. If patterns aren\'t crystallizing, re-segment.',
      'Day 10, Claude pass over all transcripts: "What do these founders consistently say that contradicts the common LATAM-SMB-AI narrative?"',
      'Day 11: write the POV doc. 1 page. 600–800 words. Single contrarian-claim headline. Publishes May 15.',
    ],
  },
  {
    title: 'The privacy firewall',
    body: `Two layers in one repository. Private capture (gitignored, never pushed) versus public output (anonymized, permission-cleared, published).`,
    detail: [
      'Full transcripts and structured records stay local in content/interviews/.',
      'Public surfaces (diary, patterns, quotes) only carry data that has cleared the firewall.',
      'Quotes attribute to "Owner, [vertical], [city], [N] staff." No names. No business names.',
      'Quote permission is collected via WhatsApp after the call, in writing, before the quote ships.',
      'Every founder receives the synthesized POV doc on May 15: the gift, not the heist.',
    ],
  },
  {
    title: 'Why this is published',
    body: `Methodology in public is the moat. A copyable site with a copyable counter is replicable. A documented synthesis discipline that turns 100 conversations into a non-obvious thesis is not. Founders who skip the method skip the only durable advantage.`,
  },
];
---

<Base
  title="Methodology"
  description="How 100 conversations become 1 non-obvious thesis. The full discipline, in public."
>
  <section class="container-page py-16 md:py-24">
    <p class="eyebrow mb-4">Methodology</p>
    <h1>How 100 conversations become 1 non-obvious thesis.</h1>
    <p class="mt-6 prose-body max-w-reading">
      The method is published in full because methodology is the moat. The site is copyable.
      The counter is copyable. The discipline that turns 100 conversations into a sharp,
      contrarian, defensible point of view in 12 days is not.
    </p>
  </section>

  {
    sections.map((section, i) => (
      <section class="section">
        <div class="container-page max-w-reading">
          <p class="eyebrow mb-3">{String(i + 1).padStart(2, '0')}</p>
          <h2>{section.title}</h2>
          <p class="mt-5 prose-body">{section.body}</p>
          {section.detail && (
            <ul class="mt-8 space-y-4">
              {section.detail.map((d) => (
                <li class="grid grid-cols-[1rem_1fr] gap-4 items-baseline">
                  <span class="font-mono text-xs text-ink-faint">▸</span>
                  <span class="text-base md:text-lg leading-relaxed text-ink-subtle">{d}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="container-page max-w-reading">
      <p class="eyebrow mb-3">Source</p>
      <p class="prose-body">
        The discipline borrows from <em>The Mom Test</em> (Rob Fitzpatrick),
        Steve Blank's customer development canon, YC's <em>Talk to Users</em> guide,
        and Eric Migicovsky's user-interview pattern. Adapted for LATAM SMBs and AI-era
        B2B by direct contact with the founders this is built for.
      </p>
      <p class="mt-8">
        <a href="/" class="font-mono text-sm tracking-wide hover:text-signal">
          ← Back to the experiment
        </a>
      </p>
    </div>
  </section>
</Base>
