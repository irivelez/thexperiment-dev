---
import Base from '@layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('diary');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const all = await getCollection('diary');
const sorted = all.sort((a, b) => b.data.day - a.data.day);
const idx = sorted.findIndex((e) => e.id === entry.id);
const newer = idx > 0 ? sorted[idx - 1] : null;
const older = idx < sorted.length - 1 ? sorted[idx + 1] : null;

function fmt(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Base
  title={entry.data.title}
  description={entry.data.excerpt}
>
  <article class="container-page py-16 md:py-24 max-w-reading">
    <header class="mb-12 space-y-4">
      <div class="flex items-baseline gap-4 font-mono text-2xs uppercase tracking-[0.18em]">
        <a href="/diary" class="text-ink-muted hover:text-ink no-underline">
          ← Diary
        </a>
        <span class="text-ink-faint">·</span>
        <span class="text-ink-muted">
          Day <span class="data text-ink">{String(entry.data.day).padStart(2, '0')}</span> of 16
        </span>
        <span class="text-ink-faint">·</span>
        <span class="text-ink-muted">{fmt(entry.data.date)}</span>
        {entry.data.conversations > 0 && (
          <>
            <span class="text-ink-faint">·</span>
            <span class="text-ink-muted">
              <span class="data text-ink">{entry.data.conversations}</span> convos
            </span>
          </>
        )}
      </div>
      <h1>{entry.data.title}</h1>
    </header>

    <div class="prose-body space-y-5">
      <Content />
    </div>

    {
      (newer || older) && (
        <nav class="mt-20 pt-8 border-t border-paper-line grid grid-cols-2 gap-6">
          <div>
            {older && (
              <a
                href={`/diary/${older.id}`}
                class="block no-underline group"
              >
                <p class="eyebrow mb-2">← Earlier</p>
                <p class="text-base group-hover:text-signal transition-colors">
                  {older.data.title}
                </p>
              </a>
            )}
          </div>
          <div class="text-right">
            {newer && (
              <a
                href={`/diary/${newer.id}`}
                class="block no-underline group"
              >
                <p class="eyebrow mb-2">Later →</p>
                <p class="text-base group-hover:text-signal transition-colors">
                  {newer.data.title}
                </p>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>
</Base>
